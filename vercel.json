{
  "rewrites": [
    {
      "source": "/donghua",
      "destination": "/donghua/index.html"
    },
    {
      "source": "/donghua/",
      "destination": "/donghua/index.html"
    },
    {
      "source": "/donghua/:slug",
      "destination": "/donghua/watch.html"
    },
    {
      "source": "/anime/:slug",
      "destination": "/watch/index.html"
    },
    {
      "source": "/profil/:username",
      "destination": "/profil/index.html"
    },
    {
      "source": "/anime",
      "destination": "/katalog/index.html"
    }
  ]
}
