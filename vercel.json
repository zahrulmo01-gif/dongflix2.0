{
  "rewrites": [
    {
      "source": "/donghua",
      "destination": "/donghua/index.html"
    },
    {
      "source": "/donghua/",
      "destination": "/donghua/index.html"
    },
    {
      "source": "/donghua/:slug",
      "destination": "/donghua/watch.html"
    },
    {
      "source": "/profil/:username",
      "destination": "/profil/index.html"
    },
    {
      "source": "/cdn/:path*",
      "destination": "https://res.cloudinary.com/pqyvpk17/image/upload/:path*"
    }
  ]
}
